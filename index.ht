/* =====================================================
   RENDER INTERACTIVE ANATOMY
===================================================== */

function renderAnatomyBoard(area,view){

const data=anatomyViews[area][view];

const board=
document.getElementById(area+"-board");

const lines=data.labels.map(label=>{

const startX=label.lx+18;
const startY=label.ly;

return `
<line
class="leader-line"
x1="${startX}%"
y1="${startY}%"
x2="${label.tx}%"
y2="${label.ty}%"
/>

<circle
class="target-dot"
cx="${label.tx}%"
cy="${label.ty}%"
r="2.5"
/>
`;

}).join("");

const labels=data.labels.map(label=>`

<button
type="button"
class="anatomy-label"
style="
left:${label.lx}%;
top:${label.ly}%;
"
onclick="speak('${escapeQuote(label.t)}')"
aria-label="播放 ${label.t} 發音"
>
${label.t}
</button>

`).join("");

board.innerHTML=`

<div class="anatomy-board">

  <div class="anatomy-picture">

    <img
    class="anatomy-image"
    src="${data.image}"
    alt="${area} anatomy">
  
  </div>

  <svg
  class="leader-svg"
  viewBox="0 0 100 100"
  preserveAspectRatio="none">

  ${lines}

  </svg>

  ${labels}

</div>

`;

}


/* =====================================================
   PAGE
===================================================== */

function openArea(area){

document.getElementById("home")
.style.display="none";

document.querySelectorAll(".detail-page")
.forEach(page=>{
page.classList.remove("active");
});

document.getElementById(area)
.classList.add("active");

window.scrollTo({
top:0,
behavior:"smooth"
});

}


function goHome(){

document.querySelectorAll(".detail-page")
.forEach(page=>{
page.classList.remove("active");
});

document.getElementById("home")
.style.display="block";

window.scrollTo({
top:0,
behavior:"smooth"
});

}


/* =====================================================
   VIEW
===================================================== */

function changeHeadView(view,button){

renderAnatomyBoard("head",view);

button.parentElement
.querySelectorAll(".view-btn")
.forEach(btn=>{
btn.classList.remove("active");
});

button.classList.add("active");

}


function changeTrunkView(view,button){

renderAnatomyBoard("trunk",view);

button.parentElement
.querySelectorAll(".view-btn")
.forEach(btn=>{
btn.classList.remove("active");
});

button.classList.add("active");

}


/* =====================================================
   SPEECH
===================================================== */

function speak(text){

if(!("speechSynthesis" in window)){

alert("這個瀏覽器目前不支援語音播放");

return;

}

window.speechSynthesis.cancel();

const utterance=
new SpeechSynthesisUtterance(text);

utterance.lang="en-US";
utterance.rate=.72;
utterance.pitch=1;

window.speechSynthesis.speak(utterance);

}


/* =====================================================
   BONE CARDS
===================================================== */

function renderBones(area){

const grid=
document.getElementById(area+"-bones");

grid.innerHTML="";

boneData[area].forEach((bone,index)=>{

const card=
document.createElement("button");

card.className="bone-card";

card.innerHTML=`

<span class="bone-zh">
${bone.zh}
</span>

<span class="bone-en">
${bone.en}
</span>

`;

card.onclick=()=>{
showBone(area,index);
};

grid.appendChild(card);

});

}


/* =====================================================
   INFO
===================================================== */

function showBone(area,index){

const bone=
boneData[area][index];

const info=
document.getElementById(area+"-info");

info.classList.remove("empty");

info.innerHTML=`

<div class="info-zh">
${bone.zh}
</div>

<div
class="info-en"
onclick="speak('${escapeQuote(bone.en)}')"
>
${bone.en} 🔊
</div>

<div class="info-description">
${bone.desc}
</div>

`;

}


function escapeQuote(text){

return String(text)
.replace(/\\/g,"\\\\")
.replace(/'/g,"\\'");

}


/* =====================================================
   MODE
===================================================== */

function setMode(area,mode,button){

const learn=
document.getElementById(area+"-learn");

const game=
document.getElementById(area+"-game");

button.parentElement
.querySelectorAll(".mode-btn")
.forEach(btn=>{
btn.classList.remove("active");
});

button.classList.add("active");

if(mode==="learn"){

learn.style.display="block";

game.classList.remove("active");

}else{

learn.style.display="none";

game.classList.add("active");

startGame(area);

}

}


/* =====================================================
   GAME
===================================================== */

let currentQuiz={};

function startGame(area){

const list=boneData[area];

const answer=
list[Math.floor(Math.random()*list.length)];

let choices=[answer];

while(choices.length<Math.min(4,list.length)){

const random=
list[Math.floor(Math.random()*list.length)];

if(!choices.includes(random)){
choices.push(random);
}

}

choices.sort(()=>Math.random()-.5);

currentQuiz={
area,
answer
};

const panel=
document.getElementById(area+"-game");

panel.innerHTML=`

<div class="quiz-card">

<div class="quiz-question">
🎯 「${answer.zh}」的英文是哪一個？
</div>

<div class="quiz-options">

${choices.map(choice=>`

<button
class="quiz-option"
onclick="checkAnswer(
'${area}',
'${escapeQuote(choice.en)}'
)"
>
${choice.en}
</button>

`).join("")}

</div>

<div
id="${area}-quiz-result"
class="quiz-result">
</div>

<button
class="next-btn"
onclick="startGame('${area}')">
下一題 ➜
</button>

</div>

`;

}


function checkAnswer(area,choice){

const result=
document.getElementById(area+"-quiz-result");

if(choice===currentQuiz.answer.en){

result.innerHTML="✅ 答對了！";

speak(currentQuiz.answer.en);

}else{

result.innerHTML=
"❌ 再想想看～正確答案是 "+
currentQuiz.answer.en;

}

}


/* =====================================================
   INIT
===================================================== */

renderAnatomyBoard("head","front");
renderAnatomyBoard("trunk","rib");
renderAnatomyBoard("upper","main");
renderAnatomyBoard("lower","main");

["head","trunk","upper","lower"]
.forEach(area=>{
renderBones(area);
});

</script>

</body>
</html>
