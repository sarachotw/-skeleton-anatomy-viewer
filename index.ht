<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>兒童醫學骨骼學習館</title>

<style>
*{
  box-sizing:border-box;
}

html{
  scroll-behavior:smooth;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",
  Arial,"Noto Sans TC",sans-serif;
  background:#f2f7fb;
  color:#29465b;
}

button{
  font-family:inherit;
}

/* =========================
   HEADER
========================= */

header{
  background:linear-gradient(135deg,#1769aa,#42a5f5);
  color:#fff;
  text-align:center;
  padding:24px 16px 28px;
}

header h1{
  margin:0;
  font-size:28px;
  font-weight:800;
}

header .english{
  margin-top:7px;
  font-size:18px;
  font-weight:700;
}

header .subtitle{
  margin-top:10px;
  font-size:15px;
  line-height:1.6;
}

/* =========================
   LAYOUT
========================= */

.container{
  width:min(950px,100%);
  margin:auto;
  padding:18px;
}

.card{
  background:#fff;
  border-radius:24px;
  padding:20px;
  margin-bottom:20px;
  box-shadow:0 5px 20px rgba(33,72,105,.08);
}

.detail-page{
  display:none;
}

.detail-page.active{
  display:block;
}

/* =========================
   HOME
========================= */

.home-title{
  text-align:center;
  font-size:25px;
  font-weight:800;
  margin-bottom:20px;
}

.area-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.area-button{
  border:2px solid #d7e8f4;
  border-radius:20px;
  background:#fff;
  min-height:120px;
  padding:18px 10px;
  cursor:pointer;
  font-size:20px;
  font-weight:800;
  color:#24658f;
}

.area-button:active{
  transform:scale(.98);
}

.area-button .icon{
  display:block;
  font-size:38px;
  margin-bottom:8px;
}

.area-button small{
  display:block;
  font-size:14px;
  color:#7d98aa;
  margin-top:5px;
}

/* =========================
   DETAIL
========================= */

.back-btn{
  border:0;
  background:#e6f3fc;
  color:#176ca8;
  padding:12px 18px;
  border-radius:18px;
  font-size:17px;
  font-weight:800;
  cursor:pointer;
}

.detail-heading{
  text-align:center;
  margin:22px 0 14px;
}

.detail-heading h2{
  margin:0 0 7px;
  color:#1268ac;
  font-size:31px;
}

.detail-heading p{
  margin:0;
  color:#7892a3;
  font-size:17px;
}

/* =========================
   MODE
========================= */

.mode-tabs{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  margin:20px 0;
}

.mode-btn{
  border:0;
  border-radius:18px;
  padding:16px 8px;
  font-size:18px;
  font-weight:800;
  color:#316a8c;
  background:#eaf4fb;
  cursor:pointer;
}

.mode-btn.active{
  background:#1976d2;
  color:#fff;
}

/* =========================
   PANEL
========================= */

.learning-panel{
  border:2px solid #d9eaf6;
  border-radius:24px;
  padding:16px;
}

.tip{
  background:#fff3c9;
  color:#745d18;
  border-radius:18px;
  padding:15px;
  text-align:center;
  font-size:16px;
  line-height:1.5;
  font-weight:700;
  margin-bottom:16px;
}

.view-buttons{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin:14px 0 18px;
}

.view-btn{
  border:0;
  background:#e7f3fc;
  color:#23688f;
  padding:10px 17px;
  border-radius:18px;
  font-size:15px;
  font-weight:800;
  cursor:pointer;
}

.view-btn.active{
  background:#1976d2;
  color:#fff;
}

/* =====================================================
   INTERACTIVE ANATOMY
===================================================== */

.anatomy-board{
  position:relative;
  width:100%;
  min-height:620px;
  background:#fff;
  border:1px solid #edf3f7;
  border-radius:22px;
  overflow:hidden;
}

.anatomy-picture{
  position:absolute;
  left:24%;
  top:4%;
  width:72%;
  height:92%;
  display:flex;
  justify-content:center;
  align-items:center;
  pointer-events:none;
}

.anatomy-image{
  display:block;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}

/* 指示線 */

.leader-svg{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  pointer-events:none;
  z-index:2;
}

.leader-line{
  stroke:#d46b63;
  stroke-width:1.6;
  stroke-dasharray:5 4;
  fill:none;
  vector-effect:non-scaling-stroke;
}

.target-dot{
  fill:#d46b63;
}

/* 真正可按的英文 */

.anatomy-label{
  position:absolute;
  z-index:5;
  transform:translateY(-50%);
  border:0;
  background:rgba(255,255,255,.94);
  color:#111;
  padding:5px 7px;
  border-radius:8px;
  cursor:pointer;
  font-family:Georgia,"Times New Roman",serif;
  font-size:16px;
  font-style:italic;
  line-height:1.05;
  white-space:nowrap;
  text-align:left;
  -webkit-tap-highlight-color:rgba(25,118,210,.15);
}

.anatomy-label::before{
  content:"●";
  font-style:normal;
  font-size:10px;
  margin-right:5px;
}

.anatomy-label:active{
  color:#1976d2;
  background:#e8f4ff;
}

.anatomy-label:hover{
  color:#1976d2;
}

/* =========================
   LEARNING CARDS
========================= */

.section-title{
  font-size:24px;
  font-weight:800;
  color:#205b81;
  margin:25px 0 15px;
}

.bone-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:14px;
}

.bone-card{
  border:2px solid #d9e8f3;
  background:#fff;
  border-radius:20px;
  padding:17px;
  text-align:left;
  cursor:pointer;
  min-height:110px;
}

.bone-card:active{
  transform:scale(.98);
}

.bone-zh{
  display:block;
  font-size:19px;
  font-weight:800;
  color:#294c66;
  margin-bottom:8px;
}

.bone-en{
  color:#1475d1;
  font-size:19px;
  font-weight:800;
}

/* =========================
   INFO
========================= */

.info-card{
  margin-top:20px;
  border:4px solid #a9d6f4;
  border-radius:28px;
  background:#edf7ff;
  padding:26px 20px;
  text-align:center;
  min-height:210px;
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.info-card.empty{
  color:#7894a8;
}

.info-zh{
  font-size:30px;
  font-weight:900;
  color:#284b64;
}

.info-en{
  margin-top:12px;
  font-size:32px;
  font-weight:900;
  color:#1274d2;
  cursor:pointer;
}

.info-description{
  margin-top:20px;
  font-size:18px;
  color:#607d91;
  line-height:1.65;
}

/* =========================
   NUMBERS
========================= */

.number-box{
  margin-top:18px;
  padding:16px;
  background:#f5fbff;
  border:2px solid #d8ebf7;
  border-radius:18px;
}

.number-row{
  padding:9px 4px;
  font-size:16px;
  line-height:1.5;
  border-bottom:1px dashed #cfdeea;
}

.number-row:last-child{
  border-bottom:0;
}

.number-row strong{
  color:#166eb4;
}

/* =========================
   GAME
========================= */

.game-panel{
  display:none;
  border:2px solid #d9eaf6;
  border-radius:24px;
  padding:20px;
}

.game-panel.active{
  display:block;
}

.quiz-card{
  background:#f5fbff;
  border-radius:22px;
  padding:22px;
  text-align:center;
}

.quiz-question{
  font-size:23px;
  font-weight:900;
  margin-bottom:20px;
  color:#295a78;
}

.quiz-options{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.quiz-option{
  border:2px solid #d2e7f5;
  background:#fff;
  border-radius:17px;
  padding:15px 8px;
  color:#236a9d;
  font-size:18px;
  font-weight:800;
  cursor:pointer;
}

.quiz-result{
  min-height:42px;
  margin-top:16px;
  font-weight:800;
  font-size:18px;
}

.next-btn{
  margin-top:10px;
  border:0;
  background:#1976d2;
  color:white;
  border-radius:18px;
  padding:13px 24px;
  font-size:17px;
  font-weight:800;
  cursor:pointer;
}

footer{
  text-align:center;
  color:#8ca2b2;
  font-size:13px;
  padding:5px 15px 30px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:640px){

  .container{
    padding:14px;
  }

  .card{
    padding:15px;
  }

  .area-button{
    min-height:105px;
    font-size:18px;
  }

  .learning-panel{
    padding:9px;
  }

  .anatomy-board{
    min-height:520px;
  }

  .anatomy-picture{
    left:29%;
    width:69%;
    top:4%;
    height:92%;
  }

  .anatomy-label{
    font-size:11px;
    padding:4px 3px;
  }

  .anatomy-label::before{
    font-size:7px;
    margin-right:3px;
  }

  .bone-grid{
    grid-template-columns:1fr 1fr;
    gap:10px;
  }

  .bone-card{
    padding:12px;
  }

  .bone-zh{
    font-size:16px;
  }

  .bone-en{
    font-size:15px;
  }

  .quiz-options{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
  <h1>🦴 兒童醫學骨骼學習館</h1>
  <div class="english">Human Skeleton Learning</div>
  <div class="subtitle">
    認識人體骨骼・直接點英文聽發音・挑戰骨骼小遊戲
  </div>
</header>

<div class="container">

<!-- =====================================================
     HOME
===================================================== -->

<section id="home" class="card">

  <div class="home-title">選一個部位開始學習 👇</div>

  <div class="area-grid">

    <button class="area-button" onclick="openArea('head')">
      <span class="icon">💀</span>
      頭部骨骼
      <small>Skull</small>
    </button>

    <button class="area-button" onclick="openArea('trunk')">
      <span class="icon">🫁</span>
      胸腹部骨骼
      <small>Trunk</small>
    </button>

    <button class="area-button" onclick="openArea('upper')">
      <span class="icon">💪</span>
      上肢骨骼
      <small>Upper limb</small>
    </button>

    <button class="area-button" onclick="openArea('lower')">
      <span class="icon">🦵</span>
      下肢骨骼
      <small>Lower limb</small>
    </button>

  </div>

</section>

<!-- =====================================================
     HEAD
===================================================== -->

<section id="head" class="detail-page card">

  <button class="back-btn" onclick="goHome()">← 回四大區</button>

  <div class="detail-heading">
    <h2>💀 頭部骨骼</h2>
    <p>Skull bones</p>
  </div>

  <div class="mode-tabs">

    <button class="mode-btn active"
      onclick="setMode('head','learn',this)">
      📖 學習模式
    </button>

    <button class="mode-btn"
      onclick="setMode('head','game',this)">
      🎮 骨頭小遊戲
    </button>

  </div>

  <div id="head-learn" class="learning-panel">

    <div class="tip">
      👆 直接點圖旁的英文名稱，就會唸出英文
    </div>

    <div class="view-buttons">

      <button class="view-btn active"
        onclick="changeHeadView('front',this)">
        正面
      </button>

      <button class="view-btn"
        onclick="changeHeadView('side',this)">
        側面
      </button>

      <button class="view-btn"
        onclick="changeHeadView('back',this)">
        背面
      </button>

    </div>

    <div id="head-board"></div>

    <div class="section-title">骨頭英文複習</div>

    <div class="bone-grid" id="head-bones"></div>

    <div id="head-info" class="info-card empty">
      點下面骨頭卡片看中文解釋 👆
    </div>

  </div>

  <div id="head-game" class="game-panel"></div>

</section>

<!-- =====================================================
     TRUNK
===================================================== -->

<section id="trunk" class="detail-page card">

  <button class="back-btn" onclick="goHome()">← 回四大區</button>

  <div class="detail-heading">
    <h2>🫁 胸腹部骨骼</h2>
    <p>Trunk skeleton</p>
  </div>

  <div class="mode-tabs">

    <button class="mode-btn active"
      onclick="setMode('trunk','learn',this)">
      📖 學習模式
    </button>

    <button class="mode-btn"
      onclick="setMode('trunk','game',this)">
      🎮 骨頭小遊戲
    </button>

  </div>

  <div id="trunk-learn" class="learning-panel">

    <div class="tip">
      👆 胸廓、脊柱、全身位置的英文都可以直接點
    </div>

    <div class="view-buttons">

      <button class="view-btn active"
        onclick="changeTrunkView('rib',this)">
        胸廓
      </button>

      <button class="view-btn"
        onclick="changeTrunkView('spine',this)">
        脊柱
      </button>

      <button class="view-btn"
        onclick="changeTrunkView('full',this)">
        全身位置
      </button>

    </div>

    <div id="trunk-board"></div>

    <div class="section-title">胸腹部英文複習</div>

    <div class="bone-grid" id="trunk-bones"></div>

    <div class="number-box">

      <div class="number-row">
        🦴 <strong>Ribs 肋骨：</strong>
        12 對，共 24 根
      </div>

      <div class="number-row">
        <strong>1–7 對：</strong>
        True ribs 真肋
      </div>

      <div class="number-row">
        <strong>8–10 對：</strong>
        False ribs 假肋
      </div>

      <div class="number-row">
        <strong>11–12 對：</strong>
        Floating ribs 浮肋
      </div>

      <div class="number-row">
        🦴 <strong>Cervical vertebrae：</strong>
        7 節，C1–C7
      </div>

      <div class="number-row">
        🦴 <strong>Thoracic vertebrae：</strong>
        12 節，T1–T12
      </div>

      <div class="number-row">
        🦴 <strong>Lumbar vertebrae：</strong>
        5 節，L1–L5
      </div>

    </div>

    <div id="trunk-info" class="info-card empty">
      點下面骨頭卡片看中文解釋 👆
    </div>

  </div>

  <div id="trunk-game" class="game-panel"></div>

</section>

<!-- =====================================================
     UPPER
===================================================== -->

<section id="upper" class="detail-page card">

  <button class="back-btn" onclick="goHome()">← 回四大區</button>

  <div class="detail-heading">
    <h2>💪 上肢骨骼</h2>
    <p>Upper limb bones</p>
  </div>

  <div class="mode-tabs">

    <button class="mode-btn active"
      onclick="setMode('upper','learn',this)">
      📖 學習模式
    </button>

    <button class="mode-btn"
      onclick="setMode('upper','game',this)">
      🎮 骨頭小遊戲
    </button>

  </div>

  <div id="upper-learn" class="learning-panel">

    <div class="tip">
      👆 直接點圖旁英文，從肩膀一路學到手指
    </div>

    <div id="upper-board"></div>

    <div class="section-title">上肢英文複習</div>

    <div class="bone-grid" id="upper-bones"></div>

    <div id="upper-info" class="info-card empty">
      點下面骨頭卡片看中文解釋 👆
    </div>

  </div>

  <div id="upper-game" class="game-panel"></div>

</section>

<!-- =====================================================
     LOWER
===================================================== -->

<section id="lower" class="detail-page card">

  <button class="back-btn" onclick="goHome()">← 回四大區</button>

  <div class="detail-heading">
    <h2>🦵 下肢骨骼</h2>
    <p>Lower limb bones</p>
  </div>

  <div class="mode-tabs">

    <button class="mode-btn active"
      onclick="setMode('lower','learn',this)">
      📖 學習模式
    </button>

    <button class="mode-btn"
      onclick="setMode('lower','game',this)">
      🎮 骨頭小遊戲
    </button>

  </div>

  <div id="lower-learn" class="learning-panel">

    <div class="tip">
      👆 直接點圖旁英文，從骨盆一路學到腳趾
    </div>

    <div id="lower-board"></div>

    <div class="section-title">下肢英文複習</div>

    <div class="bone-grid" id="lower-bones"></div>

    <div id="lower-info" class="info-card empty">
      點下面骨頭卡片看中文解釋 👆
    </div>

  </div>

  <div id="lower-game" class="game-panel"></div>

</section>

</div>

<footer>
Human Skeleton Learning・兒童骨骼英文學習
</footer>

<script>

/* =====================================================
   DATA
===================================================== */

const boneData={

head:[

{
zh:"額骨",
en:"Frontal bone",
desc:"位在額頭的位置，形成前額以及眼眶上方的一部分。"
},

{
zh:"頂骨",
en:"Parietal bone",
desc:"位在頭骨上方和兩側，左右各有一塊。"
},

{
zh:"顳骨",
en:"Temporal bone",
desc:"位在頭骨兩側、靠近耳朵的位置。"
},

{
zh:"枕骨",
en:"Occipital bone",
desc:"位在頭骨後方與底部。"
},

{
zh:"蝶骨",
en:"Sphenoid bone",
desc:"位在頭骨中央偏底部。"
},

{
zh:"篩骨",
en:"Ethmoid bone",
desc:"位在兩眼之間、鼻腔上方。"
},

{
zh:"鼻骨",
en:"Nasal bone",
desc:"位在鼻樑上方。"
},

{
zh:"淚骨",
en:"Lacrimal bone",
desc:"位在眼眶內側。"
},

{
zh:"顴骨",
en:"Zygomatic bone",
desc:"形成臉頰突出的位置。"
},

{
zh:"上顎骨",
en:"Maxilla",
desc:"形成上顎以及臉部中央的一部分。"
},

{
zh:"下顎骨",
en:"Mandible",
desc:"形成下巴與下排牙齒。"
}

],

trunk:[

{
zh:"胸骨",
en:"Sternum",
desc:"位在胸部中央。"
},

{
zh:"肋骨",
en:"Ribs",
desc:"人體共有 12 對肋骨，共 24 根。"
},

{
zh:"頸椎",
en:"Cervical vertebrae",
desc:"頸椎共有 7 節。"
},

{
zh:"第一頸椎",
en:"Atlas",
desc:"第一頸椎 C1。"
},

{
zh:"第二頸椎",
en:"Axis",
desc:"第二頸椎 C2。"
},

{
zh:"胸椎",
en:"Thoracic vertebrae",
desc:"胸椎共有 12 節。"
},

{
zh:"腰椎",
en:"Lumbar vertebrae",
desc:"腰椎共有 5 節。"
},

{
zh:"薦骨",
en:"Sacrum",
desc:"位在脊柱下方。"
},

{
zh:"尾骨",
en:"Coccyx",
desc:"位在脊柱最下端。"
},

{
zh:"脊柱",
en:"Vertebral column",
desc:"支撐身體並保護脊髓。"
}

],

upper:[

{
zh:"鎖骨",
en:"Clavicle",
desc:"連接胸骨與肩胛骨。"
},

{
zh:"肩胛骨",
en:"Scapula",
desc:"位在背部上方。"
},

{
zh:"肱骨",
en:"Humerus",
desc:"位在上臂。"
},

{
zh:"橈骨",
en:"Radius",
desc:"位在前臂拇指側。"
},

{
zh:"尺骨",
en:"Ulna",
desc:"位在前臂小指側。"
},

{
zh:"腕骨",
en:"Carpals",
desc:"位在手腕。"
},

{
zh:"掌骨",
en:"Metacarpals",
desc:"位在手掌。"
},

{
zh:"指骨",
en:"Phalanges",
desc:"形成手指。"
}

],

lower:[

{
zh:"髖骨",
en:"Hip bone",
desc:"骨盆的重要部分。"
},

{
zh:"股骨",
en:"Femur",
desc:"人體最長的骨頭。"
},

{
zh:"髕骨",
en:"Patella",
desc:"位在膝關節前方。"
},

{
zh:"脛骨",
en:"Tibia",
desc:"位在小腿內側。"
},

{
zh:"腓骨",
en:"Fibula",
desc:"位在小腿外側。"
},

{
zh:"跗骨",
en:"Tarsals",
desc:"位在腳踝。"
},

{
zh:"蹠骨",
en:"Metatarsals",
desc:"位在腳掌。"
},

{
zh:"趾骨",
en:"Phalanges",
desc:"形成腳趾。"
}

]

};


